<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>com.surakshasetu</groupId>
  <artifactId>domain-services</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>domain-services</name>
  <description>SurakshaSetu domain tier: consent, catalog, disclosures, eligibility, suitability, ranking, quotes.</description>

  <properties>
    <java.version>21</java.version>
    <spotless.version>3.10.2</spotless.version>
    <google-java-format.version>1.36.1</google-java-format.version>
    <openapi-generator.version>7.25.0</openapi-generator.version>
    <java-json-canonicalization.version>1.1</java-json-canonicalization.version>
    <openapi-request-validator.version>3.0.0</openapi-request-validator.version>
  </properties>

  <dependencies>
    <!-- Boot 4 renamed spring-boot-starter-web to spring-boot-starter-webmvc. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <!-- The generated interfaces carry jakarta.validation annotations. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!-- RFC 8785 reference implementation; no dependencies, so no Jackson 2 on the classpath. -->
    <dependency>
      <groupId>io.github.erdtman</groupId>
      <artifactId>java-json-canonicalization</artifactId>
      <version>${java-json-canonicalization.version}</version>
    </dependency>
    <!-- The seed loader reads content/seed/**/*.yaml into records; Jackson 3 keeps dates as text,
         where SnakeYAML would turn them into java.util.Date. Version from Boot's Jackson BOM. -->
    <dependency>
      <groupId>tools.jackson.dataformat</groupId>
      <artifactId>jackson-dataformat-yaml</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- MigrationsIT drives infra/db/migrations through the Flyway API. Test scope and no Boot
         Flyway starter: the service itself never migrates. -->
    <!-- Asserts every MockMvc response against the tier contract. The artifact formerly named
         swagger-request-validator-mockmvc; 3.0.0 targets Spring 7 and OpenAPI 3.1. It brings
         Jackson 2 onto the test classpath only. -->
    <dependency>
      <groupId>com.atlassian.oai</groupId>
      <artifactId>openapi-request-validator-mockmvc</artifactId>
      <version>${openapi-request-validator.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>${project.artifactId}</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <!-- Interfaces and models from the tier contract, regenerated on every build into
           target/generated-sources/openapi, so they cannot drift from the spec. -->
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <version>${openapi-generator.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${project.basedir}/../contracts/openapi/domain-services.v1.yaml</inputSpec>
              <generatorName>spring</generatorName>
              <apiPackage>com.surakshasetu.domain.contract</apiPackage>
              <modelPackage>com.surakshasetu.domain.contract.model</modelPackage>
              <configOptions>
                <interfaceOnly>true</interfaceOnly>
                <useTags>true</useTags>
                <useJakartaEe>true</useJakartaEe>
                <useSpringBoot4>true</useSpringBoot4>
                <useJackson3>true</useJackson3>
                <openApiNullable>false</openApiNullable>
                <documentationProvider>none</documentationProvider>
                <annotationLibrary>none</annotationLibrary>
                <!-- Omit unset optional fields instead of writing null; required ones always appear. -->
                <generateJsonIncludeAnnotations>true</generateJsonIncludeAnnotations>
                <generateJsonSetterNullsAnnotations>false</generateJsonSetterNullsAnnotations>
                <hideGenerationTimestamp>true</hideGenerationTimestamp>
              </configOptions>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Runs *IT classes in the integration-test phase; executions come from the Boot parent. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <googleJavaFormat>
              <version>${google-java-format.version}</version>
            </googleJavaFormat>
          </java>
        </configuration>
        <executions>
          <execution>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
