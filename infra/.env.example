# Dummy local values, identical to the defaults in compose.yaml. Copy this file to infra/.env
# (gitignored): it works as it is. Keep them URL-safe: minio-init embeds the MinIO credentials in a URL.
POSTGRES_PASSWORD=surakshasetu-dev
MINIO_ROOT_USER=surakshasetu
MINIO_ROOT_PASSWORD=surakshasetu-dev-minio

# Passwords for the Postgres LOGIN roles that V1__roles_schemas.sql creates, passed to Flyway as
# placeholders. No single quotes: they land inside SQL string literals and DSNs. V1 runs once per
# database, so changing one later needs an ALTER ROLE, not a re-migrate.
APP_RW_PASSWORD=surakshasetu-dev-app-rw
DOMAIN_RW_PASSWORD=surakshasetu-dev-domain-rw
CATALOG_LOADER_PASSWORD=surakshasetu-dev-catalog-loader
ERASURE_RW_PASSWORD=surakshasetu-dev-erasure-rw
KEYVAULT_RW_PASSWORD=surakshasetu-dev-keyvault-rw
COMPLIANCE_RO_PASSWORD=surakshasetu-dev-compliance-ro

# domain-services' service-to-service tokens (Step 16): every /v1 call needs DOMAIN_TOKEN as a
# bearer, and the kill switch also DOMAIN_INTERNAL_TOKEN. They must equal the orchestrator's
# SS_DOMAIN_TOKEN and SS_DOMAIN_INTERNAL_TOKEN (orchestrator/.env.example).
DOMAIN_TOKEN=surakshasetu-dev-domain-token
DOMAIN_INTERNAL_TOKEN=surakshasetu-dev-domain-internal-token

# TEI image for tei-embed and tei-rerank. compose.yaml's default is arm64-only (Apple silicon); on
# an amd64 host, uncomment this.
# TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.9.4

# SurakshaSetu's OmniRoute (compose profile gateway, Step 9). OmniRoute refuses to start with a
# JWT_SECRET under 32 characters or an API_KEY_SECRET under 16. INITIAL_PASSWORD is read only on
# the gateway volume's first boot (the seed script logs in with it): to change it later, also
# `docker volume rm surakshasetu_omniroute-data` and rerun `make gateway-up`.
OMNIROUTE_INITIAL_PASSWORD=surakshasetu-dev-omniroute
OMNIROUTE_JWT_SECRET=surakshasetu-dev-omniroute-jwt-signing
OMNIROUTE_API_KEY_SECRET=surakshasetu-dev-omniroute-api-key
OMNIROUTE_STORAGE_ENCRYPTION_KEY=surakshasetu-dev-omniroute-storage

# The orchestrator's SS_* settings are not read from this file: see orchestrator/.env.example.
