# The orchestrator's settings (surakshasetu/config.py). To override, copy this file to
# orchestrator/.env (gitignored) and edit. Settings reads .env from the working directory, and every
# make target runs the orchestrator from orchestrator/. A real environment variable beats the file.
#
# Commented lines show the built-in dev default: uncomment only what you change. Outside dev
# (SS_ENV=pilot or prod) every setting in REQUIRED_OUTSIDE_DEV must be set explicitly, so a dev
# default never reaches a pilot by accident. Never put a real secret in this file.

# dev | test | pilot | prod
SS_ENV=dev

# Postgres as app_rw (no default: needed by the checkpointer setup and `make verify-audit`, which
# pass their own). Required outside dev.
SS_PG_DSN_APP=postgresql://app_rw:surakshasetu-dev-app-rw@127.0.0.1:5432/surakshasetu

# Valkey/Redis (no default; used from Step 14a). Required outside dev.
SS_REDIS_URL=redis://127.0.0.1:6379/0

# domain-services. The token is required outside dev.
# SS_DOMAIN_BASE_URL=http://127.0.0.1:8080
# SS_DOMAIN_TOKEN=surakshasetu-dev-domain-token

# Subject keys (Step 4). The KEK is base64 of 32 bytes; this dev value is public. In prod the KEK
# lives in an India-region KMS/HSM. Postgres as keyvault_rw. Both required outside dev.
# SS_KEK_B64=c3VyYWtzaGFzZXR1LWRldi1rZWstbm90LXNlY3JldCE=
# SS_PG_DSN_KEYVAULT=postgresql://keyvault_rw:surakshasetu-dev-keyvault-rw@127.0.0.1:5432/surakshasetu

# Audit anchoring (Step 4). MinIO credentials match infra/.env's MINIO_ROOT_*. Unset
# SS_TSA_KEY_PATH signs with a dev key derived from a public constant; outside dev it must point
# to an Ed25519 private key (PEM). Retention is in days of COMPLIANCE object lock. All required
# outside dev.
# SS_MINIO_ENDPOINT=http://127.0.0.1:9000
# SS_MINIO_ACCESS_KEY=surakshasetu
# SS_MINIO_SECRET_KEY=surakshasetu-dev-minio
# SS_TSA_KEY_PATH=/path/to/tsa-ed25519.pem
# SS_ANCHOR_RETENTION_DAYS=1

# Model path (Step 8). Chat routes go to the gateway: the stubs until Step 9, then OmniRoute.
# embed and rerank go straight to the TEI services, never through the gateway. The gateway URL and
# key and both TEI URLs are required outside dev.
# SS_GATEWAY_BASE_URL=http://127.0.0.1:8090/v1
# SS_GATEWAY_API_KEY=surakshasetu-dev-gateway-key
# SS_TEI_EMBED_URL=http://127.0.0.1:8081
# SS_TEI_RERANK_URL=http://127.0.0.1:8082
# Bound to the embedding model in infra/compose.yaml: its vector size, and the instruction an
# instruction-tuned model needs before queries only (empty for BGE-M3).
# SS_EMBED_DIM=1024
# SS_EMBED_QUERY_PREFIX=

# Logging. SS_LOG_DIR (unset: no files) adds one rotating JSON file per subsystem; text is a
# coloured console for local reading only.
# SS_LOG_LEVEL=INFO
# SS_LOG_DIR=../logs
# SS_LOG_FORMAT=json

# Test-only, not read from this file: `make check-db` and `make check-stack` export
# SS_TEST_PG_DSN_ADMIN and SS_TEST_PG_DSN_KEYVAULT (built from infra/.env's passwords). The
# gateway stack test scripts the stubs at SS_TEST_STUBS_URL (default http://127.0.0.1:8090).
